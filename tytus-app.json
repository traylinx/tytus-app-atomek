{
  "$schema": "https://tytus.traylinx.com/schema/app/v1.json",
  "id": "atomek",
  "name": "Atomek",
  "version": "0.4.16",
  "icon": "Sparkles",
  "category": "Productivity",
  "description": "Atomek — Monaco workspace with intelligent AIL chat, dynamic file context, project indexing, semantic retrieval, AI edit previews, and Tytus computer/agent controller.",
  "window": {
    "defaultSize": {
      "width": 1200,
      "height": 780
    },
    "minSize": {
      "width": 760,
      "height": 520
    }
  },
  "permissions": [
    "daemon.read",
    "daemon.network",
    "vfs.user.documents",
    "shell.notifications",
    "shell.dock",
    "ai.chat",
    "ai.memory.read",
    "ai.memory.write",
    "ai.artifacts"
  ],
  "entry": {
    "url": "https://cdn.jsdelivr.net/gh/traylinx/tytus-app-atomek@v0.4.16/dist/index.js"
  },
  "contributes": {
    "fileAssociations": [
      {
        "extension": ".md",
        "mimeType": "text/markdown"
      },
      {
        "extension": ".txt",
        "mimeType": "text/plain"
      },
      {
        "extension": ".json",
        "mimeType": "application/json"
      },
      {
        "extension": ".csv",
        "mimeType": "text/csv"
      },
      {
        "extension": ".ts",
        "mimeType": "text/typescript"
      },
      {
        "extension": ".tsx",
        "mimeType": "text/typescript-jsx"
      },
      {
        "extension": ".js",
        "mimeType": "text/javascript"
      },
      {
        "extension": ".css",
        "mimeType": "text/css"
      },
      {
        "extension": ".html",
        "mimeType": "text/html"
      }
    ],
    "agentSkills": [
      {
        "id": "atomek.inspect-project",
        "title": "Inspect Atomek workspace",
        "description": "Inspect open files, selected content, project index, and Cortex context safely.",
        "driver": "host-api",
        "skillUrl": "skills/atomek.inspect-project.md",
        "triggers": [
          "inspect",
          "project",
          "workspace",
          "files",
          "context"
        ]
      },
      {
        "id": "atomek.generate-patch-preview",
        "title": "Generate Atomek patch preview",
        "description": "Generate diff/replacement output that Atomek can convert into preview edits before applying.",
        "driver": "host-api",
        "skillUrl": "skills/atomek.generate-patch-preview.md",
        "triggers": [
          "patch",
          "edit",
          "preview",
          "diff",
          "apply"
        ]
      },
      {
        "id": "atomek.local-agent-job",
        "title": "Run local agent job",
        "description": "Run allowlisted local AI CLIs through Tytus tray and stream output back into Atomek.",
        "driver": "local-job",
        "skillUrl": "skills/atomek.local-agent-job.md",
        "triggers": [
          "agent",
          "job",
          "local",
          "codex",
          "claude",
          "opencode",
          "pi",
          "kimi"
        ]
      }
    ]
  }
}
