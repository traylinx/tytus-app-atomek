{
  "$schema": "https://tytus.traylinx.com/schema/app/v1.json",
  "id": "atomek",
  "name": "Atomek",
  "version": "0.4.4",
  "icon": "Sparkles",
  "category": "Productivity",
  "description": "Atomek — Monaco workspace with intelligent AIL chat, dynamic file context, project indexing, semantic retrieval, markdown preview, and AI edit previews.",
  "window": {
    "defaultSize": {
      "width": 1200,
      "height": 780
    },
    "minSize": {
      "width": 760,
      "height": 520
    }
  },
  "permissions": [
    "daemon.read",
    "daemon.network",
    "vfs.user.documents",
    "shell.notifications",
    "shell.dock",
    "ai.chat",
    "ai.memory.read",
    "ai.memory.write",
    "ai.artifacts"
  ],
  "entry": {
    "url": "https://cdn.jsdelivr.net/gh/traylinx/tytus-app-atomek@v0.4.4/dist/index.js"
  },
  "contributes": {
    "fileAssociations": [
      {
        "extension": ".md",
        "mimeType": "text/markdown"
      },
      {
        "extension": ".txt",
        "mimeType": "text/plain"
      },
      {
        "extension": ".json",
        "mimeType": "application/json"
      },
      {
        "extension": ".csv",
        "mimeType": "text/csv"
      },
      {
        "extension": ".ts",
        "mimeType": "text/typescript"
      },
      {
        "extension": ".tsx",
        "mimeType": "text/typescript-jsx"
      },
      {
        "extension": ".js",
        "mimeType": "text/javascript"
      },
      {
        "extension": ".css",
        "mimeType": "text/css"
      },
      {
        "extension": ".html",
        "mimeType": "text/html"
      }
    ]
  }
}
